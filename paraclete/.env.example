# Twitch app credentials from dev.twitch.tv (confidential client)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Channel (login name) the bot joins
TWITCH_CHANNEL=

# SQLite file; the container overrides this to /data/paraclete.db
DB_PATH=./data/paraclete.db

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Outgoing chat messages per 30 seconds. 20 is Twitch's limit for a bot
# that isn't a moderator; a moderator bot may use up to 100.
CHAT_RATE_LIMIT=20
