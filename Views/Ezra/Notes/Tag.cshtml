@model List<Note>
@{
    ViewData["Title"] = ViewData["TagName"];
}
<div class="ezra-title-row">
    <h1>Tagged “@ViewData["TagName"]”</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="New" asp-route-tag="@ViewData["TagName"]" asp-route-returnUrl="@Context.Request.Path" class="ezra-button">New note</a>
    }
</div>
<p class="ezra-meta"><a asp-action="Index">All notes</a></p>
<partial name="_NoteList" model="Model" />
