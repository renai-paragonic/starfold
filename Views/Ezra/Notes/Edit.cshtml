@model NoteForm
@{
    var noteId = ViewData["NoteId"] as int?;
    var lemmas = (Dictionary<string, string>)ViewData["Lemmas"]!;
    ViewData["Title"] = noteId is null ? "New note" : "Edit note";
    ViewData["MainClass"] = "ezra-main-wide";
}
<h1>@ViewData["Title"]</h1>
<form asp-action="@(noteId is null ? "New" : "Edit")" asp-route-id="@noteId" method="post"
      class="ezra-editor" data-preview-url="/ezra/preview">
    <div asp-validation-summary="All" class="ezra-error"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" autocomplete="off" />
    <label class="ezra-check"><input asp-for="IsPublic" /> Public</label>
    <label for="tag-search">Tags</label>
    <div class="ezra-tags"
         data-all-tags="@System.Text.Json.JsonSerializer.Serialize(ViewData["AllTags"])"
         data-tag-pattern="@TagName.ClientPattern" data-tag-rule="@TagName.Rule">
        <ul class="ezra-chips">
            @foreach (var tag in Model.Tags)
            {
                <li class="ezra-chip">
                    @tag<input type="hidden" name="Tags" value="@tag" />
                    <button type="button" aria-label="Remove tag @tag">×</button>
                </li>
            }
        </ul>
        <input id="tag-search" type="text" placeholder="Add a tag…" autocomplete="off"
               role="combobox" aria-expanded="false" aria-controls="tag-options" aria-autocomplete="list" />
        <ul id="tag-options" class="ezra-flyout" role="listbox" aria-label="Tags" hidden></ul>
    </div>
    <label asp-for="References"></label>
    <div class="ezra-refs" data-suggest-url="/ezra/search/suggest">
        <ul class="ezra-chips">
            @foreach (var value in Model.ReferenceChips)
            {
                var strongs = starfold_mobile.Bible.StrongsParser.Normalize(value);
                var label = strongs is not null && lemmas.TryGetValue(strongs, out var lemma) ? $"{strongs} {lemma}" : value;
                <li class="@(strongs is null ? "ezra-chip ezra-chip-ref" : "ezra-chip ezra-chip-strongs")" data-kind="@(strongs is null ? "ref" : "strongs")">
                    @label<input type="hidden" name="ReferenceChips" value="@(strongs ?? value)" />
                    <button type="button" aria-label="Remove @label">×</button>
                </li>
            }
        </ul>
        <input asp-for="References" autocomplete="off" placeholder="John 3:16-18, 21; Rom 8; G26"
               role="combobox" aria-expanded="false" aria-controls="ref-options" aria-autocomplete="list" />
        <ul id="ref-options" class="ezra-flyout" role="listbox" aria-label="Scripture and Strong's" hidden></ul>
    </div>
    <div class="ezra-tabs">
        <button type="button" data-mode="write" aria-pressed="true">Write</button>
        <button type="button" data-mode="preview" aria-pressed="false">Preview</button>
    </div>
    @* Desktop only; ezra.js shows it when the browser can keep the window updated. *@
    <div class="ezra-popout-tools">
        <button type="button" class="ezra-button" data-popout-url="/ezra/collection" hidden>Pop out preview</button>
    </div>
    <div class="ezra-panes" data-mode="write">
        <textarea asp-for="BodyMd" aria-label="Body (Markdown)"></textarea>
        <div class="ezra-preview ezra-prose" aria-live="polite">@Html.Raw(NoteMarkdown.ToHtml(Model.BodyMd))</div>
    </div>
    <div class="ezra-actions">
        <button type="submit" class="ezra-button">Save</button>
        @if (Model.ReturnUrl is not null)
        {
            <input type="hidden" asp-for="ReturnUrl" />
            <a href="@Model.ReturnUrl">Cancel</a>
        }
        else if (noteId is null)
        {
            <a asp-action="Index">Cancel</a>
        }
        else
        {
            <a asp-action="Show" asp-route-id="@noteId">Cancel</a>
        }
    </div>
</form>
@if (noteId is not null)
{
    <form asp-action="Delete" asp-route-id="@noteId" method="post" class="ezra-delete" data-confirm="Delete this note? This can't be undone.">
        <button type="submit" class="ezra-danger">Delete note</button>
    </form>
}
