@model List<Note>
@{
    var q = (string)ViewData["Query"]!;
    var chips = (List<NoteSearch.Chip>)ViewData["SearchChips"]!;
    var labels = chips.Select(c => c.Label).Append(q == "" ? null : $"“{q}”").OfType<string>();
    ViewData["Title"] = chips.Count == 0 && q == "" ? "Search" : "Search: " + string.Join(", ", labels);
}
<h1>Search</h1>
@if (q == "" && chips.Count == 0)
{
    <p class="ezra-meta">Search titles, note text and tags. Pick a suggestion to add a tag, scripture or Strong's filter.</p>
}
else
{
    <ul class="ezra-chips">
        @foreach (var chip in chips)
        {
            <li><a href="@chip.Link" class="@chip.CssClass">@chip.Label</a></li>
        }
        @if (q != "")
        {
            <li class="ezra-search-text">“@q”</li>
        }
    </ul>
    <p class="ezra-meta">
        @Model.Count note@(Model.Count == 1 ? "" : "s") found · <a asp-action="Index">All notes</a>
    </p>
    @if (Model.Count > 0)
    {
        <partial name="_NoteList" model="Model" />
    }
}
