@using starfold_mobile.Bible
@model List<Note>
@{
    var r = (ScriptureRef)ViewData["Ref"]!;
    var book = BibleBooks.Get(r.Book);
    ViewData["Title"] = r.Format();
}
<div class="ezra-title-row">
    <h1>@r.Format()</h1>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="New" asp-route-references="@r.Format()" asp-route-returnUrl="@Context.Request.Path" class="ezra-button">New note</a>
    }
</div>
<p class="ezra-meta">
    <a asp-action="Index">All notes</a>
    @if (r.Chapter is not null)
    {
        <text> · </text><a href="@(new ScriptureRef(r.Book).BrowsePath)">@book.Name</a>
    }
    @if (r.VerseStart is not null)
    {
        <text> · </text><a href="@(new ScriptureRef(r.Book, r.Chapter).BrowsePath)">@book.Name @r.Chapter</a>
    }
    · <a href="@r.GatewayUrl" target="_blank" rel="noopener">Read in the LSB</a>
</p>
<partial name="_NoteList" model="Model" />
