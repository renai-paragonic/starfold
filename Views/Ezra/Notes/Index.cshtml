@model List<Note>
@{
    ViewData["Title"] = "Notes";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<div class="ezra-title-row">
    <h1>Notes</h1>
    @if (signedIn)
    {
        <a asp-action="New" class="ezra-button">New note</a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="ezra-meta">No notes yet.</p>
}
else
{
    <ul class="ezra-note-list">
        @foreach (var note in Model)
        {
            <li>
                <a asp-action="Show" asp-route-id="@note.Id" asp-route-slug="@note.Slug">@note.Title</a>
                <span class="ezra-meta">@note.UpdatedAt.ToString("MMM d, yyyy")</span>
                @if (!note.IsPublic)
                {
                    <span class="ezra-badge">Private</span>
                }
            </li>
        }
    </ul>
}
